# Response headers for hosts that can send them — Cloudflare, Netlify. Vite
# copies this file into dist/, which is the assets directory wrangler.toml
# points at.
#
# The cross-origin isolation headers that used to be the whole reason for this
# file are gone with the on-device speech model: they existed to unlock WASM
# threads for ONNX Runtime, and nothing in the page runs WASM any more.
# Recognition is the browser's own service now.
#
# What is left is ordinary hardening, which is worth having on its own terms.

/*
  # No frames: there is nothing here worth embedding, and
  # a microphone prompt inside somebody else's frame is a phishing tool.
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: microphone=(self), camera=(), geolocation=()

# Hashed assets never change under the same name, so they can be kept forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must not be: a stale one pins an old build indefinitely.
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
