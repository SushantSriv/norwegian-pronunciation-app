# Base URL of the FastAPI backend (see backend/README section for its own env vars)
VITE_API_URL=http://localhost:8000

# Optional: cookie-less analytics endpoint (e.g. a GoatCounter /count URL).
# Leave unset to ship with no tracking at all.
# VITE_ANALYTICS_URL=https://YOURNAME.goatcounter.com/count

# Optional: leaderboard server (see server/README.md). Leave unset and the app
# keeps points on the device only and contacts nothing.
# VITE_LEADERBOARD_URL=https://norsk-uttale-leaderboard.YOURNAME.workers.dev

# Optional: the shared exam room for Prøverommet (see server/ROM.md). Two
# candidates open the same room and practise the conversation task together,
# with the audio going directly between their browsers.
#
# LEAVE IT UNSET AND THE PAIR FEATURE IS NOT SHOWN AT ALL — the app refuses to
# offer a button that cannot work — so an app without it simply looks like the
# feature was never built.
# VITE_ROOM_URL=https://norsk-uttale-rom.YOURNAME.workers.dev
