# Base URL of the FastAPI backend (see backend/README section for its own env vars)
VITE_API_URL=http://localhost:8000

# Optional: cookie-less analytics endpoint (e.g. a GoatCounter /count URL).
# Leave unset to ship with no tracking at all.
# VITE_ANALYTICS_URL=https://YOURNAME.goatcounter.com/count

# --- Hosting ---
# Absolute origin, used for Open Graph link previews. Set this to your domain.
# VITE_SITE_URL=https://your-domain.example

# Sub-path the app is served from. Leave unset for Cloudflare Pages or a custom
# domain (served from root). GitHub Pages needs '/<repo-name>/'.
# VITE_BASE_PATH=/norwegian-pronunciation-app/
