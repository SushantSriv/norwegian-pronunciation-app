{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [ "ES2022", "DOM", "DOM.Iterable" ],
    "module": "ESNext",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true, 

    /* Bundler mode */
    "moduleResolution": "Node",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* JSON modules */
    "resolveJsonModule": true,
    "esModuleInterop": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  /* The two workers are checked here, because the rules they share with the
     browser live in src/utils and must not drift.

     The Node-only files beside them are NOT, and that is the point: this is
     the project `npm run build` compiles, and a site build has no business
     depending on Node type declarations. It did for months without anybody
     noticing, and the day a clean install stopped providing them the site
     stopped building. dev-server.ts, sqlite-d1.ts and the worker tests are
     checked in tsconfig.node.json, where Node types belong. */
  "include": [ "src", "server/worker.ts", "server/room.ts" ]
}
